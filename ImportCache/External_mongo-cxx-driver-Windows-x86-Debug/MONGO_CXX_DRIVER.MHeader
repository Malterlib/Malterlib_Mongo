%Target "Com_mongo-c-driver_mlib-ckdint-test"
{
	Compile
	{
		!!Compile.Type "C++"
		SearchPath += [
			`@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/common/src`->MakeAbsolute()
		]
		PreprocessorDefines += [
			"_BSD_SOURCE",
			"_DEFAULT_SOURCE",
			"_MLIB_BUILD_CONFIG=Debug",
			"_XOPEN_SOURCE=700"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Target.Group "External/mongo-c-driver"
	{
		!!Target.Group undefined
	}
	Target.Type "ConsoleExecutable"
	Target.BaseName "mongo-c-driver_mlib-ckdint-test"
	Target.BaseFileName "mlib-ckdint-test"
	%Group "mongo-c-driver"
	{
		%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/common/src/mlib/ckdint.test.cpp`
		{
			Compile.Type "C++"
		}
	}
}
