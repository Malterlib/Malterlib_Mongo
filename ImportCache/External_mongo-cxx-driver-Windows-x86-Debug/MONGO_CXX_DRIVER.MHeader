%Target "Tool_MONGO_CXX_DRIVER_distcheck"
{
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Compile.Disabled true
	Target.Group "External/MONGO_CXX_DRIVER"
	{
		!!Target.Group undefined
	}
	Target.Type "Tool"
	Target.BaseName "MONGO_CXX_DRIVER_distcheck"
	Target.BaseFileName "distcheck"
	%Group "Windows"
	{
		%Group "x86"
		{
			%Group `@(FullConfiguration)`
			{
				%Group "CMakeFiles"
				{
					%File `@('.'->MakeAbsolute())/CMakeFiles/distcheck.rule`
					{
						Compile
						{
							Type "Custom"
							Custom_CommandLine `MToolCMake -D CMAKE_MODULE_PATH=@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/cmake/make_dist -D CMAKE_PREFIX_PATH= -D PACKAGE_PREFIX=mongo-cxx-driver-r2.1.2 -DCMAKE_CXX_STANDARD=14 -DBSONCXX_POLY_USE_IMPLS=OFF -DBSONCXX_POLY_USE_STD=ON -P @(`@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/cmake/make_dist/MakeDistCheck.cmake`->MakeAbsolute()->EscapeHost())`
							AllowNonExisting true
							Disabled false
							Custom_WorkingDirectory `@('.'->MakeAbsolute())`->MakeAbsolute()
							Custom_Outputs []
							Custom_Inputs []
						}
					}
				}
			}
		}
	}
	%Dependency "Tool_MONGO_CXX_DRIVER_dist"
	{
		Dependency.Link false
	}
}
