%Target "Lib_libmongoc_utf8proc_obj"
{
	Compile
	{
		!!Compile.Type "C"
		SearchPath += []
		PreprocessorDefines += [
			"HAVE_STDARG_H",
			"UTF8PROC_STATIC",
			"_BSD_SOURCE",
			"_CRT_SECURE_NO_WARNINGS",
			"_DEFAULT_SOURCE",
			"_MLIB_BUILD_CONFIG=Debug",
			"_XOPEN_SOURCE=700"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Target.Group "External/libmongoc"
	{
		!!Target.Group undefined
	}
	Target.Type "StaticLibrary"
	Target.BaseName "libmongoc_utf8proc_obj"
	Target.BaseFileName "utf8proc_obj"
	Target.ObjectLibrary true
	%Group "mongo-c-driver"
	{
		%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/utf8proc-2.8.0/utf8proc.c`
		{
			Compile.Type "C"
		}
	}
}
