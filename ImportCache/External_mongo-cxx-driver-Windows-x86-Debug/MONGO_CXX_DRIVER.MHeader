%Target "Tool_MONGO_CXX_DRIVER_run-examples-api-runner"
{
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Compile.Disabled true
	Target.Group "External/MONGO_CXX_DRIVER"
	{
		!!Target.Group undefined
	}
	Target.Type "Tool"
	Target.BaseName "MONGO_CXX_DRIVER_run-examples-api-runner"
	Target.BaseFileName "run-examples-api-runner"
	%Group "Windows"
	{
		%Group "x86"
		{
			%Group `@(FullConfiguration)`
			{
				%Group "examples"
				{
					%Group "CMakeFiles"
					{
						%File `@('.'->MakeAbsolute())/examples/CMakeFiles/run-examples-api-runner.rule`
						{
							Compile
							{
								Type "Custom"
								Custom_CommandLine `api\\runner`
								AllowNonExisting true
								Disabled false
								Custom_WorkingDirectory `@('.'->MakeAbsolute())/examples`->MakeAbsolute()
								Custom_Outputs []
								Custom_Inputs []
							}
						}
					}
				}
			}
		}
	}
}
%Target "Com_MONGO_CXX_DRIVER_microbenchmarks"
{
	Compile
	{
		!!Compile.Type "C++"
		SearchPath += [
			`@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/mongocxx/include/mongocxx/v_noabi`->MakeAbsolute(),
			`@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/mongocxx/include`->MakeAbsolute(),
			`@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/mongocxx/lib/mongocxx/v_noabi`->MakeAbsolute(),
			`@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/mongocxx/lib`->MakeAbsolute(),
			`@('.'->MakeAbsolute())/src/mongocxx/lib`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-cxx-driver`->MakeAbsolute(),
			`@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/include/bsoncxx/v_noabi`->MakeAbsolute(),
			`@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/include`->MakeAbsolute(),
			`@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/lib/bsoncxx/v_noabi`->MakeAbsolute(),
			`@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/lib`->MakeAbsolute(),
			`@('.'->MakeAbsolute())/src/bsoncxx/lib`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-cxx-driver`->MakeAbsolute()
		]
		PreprocessorDefines += [
			"BSONCXX_STATIC",
			"MONGOCXX_STATIC"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Target.Group "External/MONGO_CXX_DRIVER"
	{
		!!Target.Group undefined
	}
	Target.Type "ConsoleExecutable"
	Target.BaseName "MONGO_CXX_DRIVER_microbenchmarks"
	Target.BaseFileName "microbenchmarks"
	%Group "benchmark"
	{
		%Group "bson"
		{
			%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/bson/bson_decoding.hpp`
			{
				Compile.Disabled true
			}
			%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/bson/bson_encoding.hpp`
			{
				Compile.Disabled true
			}
		}
		%Group "multi_doc"
		{
			%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/multi_doc/find_many.hpp`
			{
				Compile.Disabled true
			}
			%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/multi_doc/gridfs_download.hpp`
			{
				Compile.Disabled true
			}
			%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/multi_doc/gridfs_upload.hpp`
			{
				Compile.Disabled true
			}
			%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/multi_doc/bulk_insert.hpp`
			{
				Compile.Disabled true
			}
		}
		%Group "parallel"
		{
			%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/parallel/gridfs_multi_export.hpp`
			{
				Compile.Disabled true
			}
			%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/parallel/gridfs_multi_import.hpp`
			{
				Compile.Disabled true
			}
			%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/parallel/json_multi_import.hpp`
			{
				Compile.Disabled true
			}
			%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/parallel/json_multi_export.hpp`
			{
				Compile.Disabled true
			}
		}
		%Group "single_doc"
		{
			%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/single_doc/find_one_by_id.hpp`
			{
				Compile.Disabled true
			}
			%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/single_doc/insert_one.hpp`
			{
				Compile.Disabled true
			}
			%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/single_doc/run_command.hpp`
			{
				Compile.Disabled true
			}
		}
		%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/benchmark_runner.cpp`
		{
			Compile.Type "C++"
		}
		%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/main.cpp`
		{
			Compile.Type "C++"
		}
		%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/microbench.cpp`
		{
			Compile.Type "C++"
		}
		%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/benchmark/score_recorder.cpp`
		{
			Compile.Type "C++"
		}
	}
	%Dependency "Lib_libbson_bson_static"
	%Dependency "Lib_BSONCXX_bsoncxx_static"
	%Dependency "Lib_libmongoc_mongoc_static"
	%Dependency "Lib_MONGOCXX_mongocxx_static"
}
%Target "Tool_MONGO_CXX_DRIVER_uninstall"
{
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Compile.Disabled true
	Target.Group "External/MONGO_CXX_DRIVER"
	{
		!!Target.Group undefined
	}
	Target.Type "Tool"
	Target.BaseName "MONGO_CXX_DRIVER_uninstall"
	Target.BaseFileName "uninstall"
	%Group "Windows"
	{
		%Group "x86"
		{
			%Group `@(FullConfiguration)`
			{
				%Group "generate_uninstall"
				{
					%Group "CMakeFiles"
					{
						%File `@('.'->MakeAbsolute())/generate_uninstall/CMakeFiles/uninstall.rule`
						{
							Compile
							{
								Type "Custom"
								Custom_CommandLine `@(`@('.'->MakeAbsolute())/generate_uninstall/uninstall.cmd`->MakeAbsolute()->EscapeHost())`
								AllowNonExisting true
								Disabled false
								Custom_WorkingDirectory `@('.'->MakeAbsolute())/generate_uninstall`->MakeAbsolute()
								Custom_Outputs []
								Custom_Inputs []
							}
						}
					}
				}
			}
		}
	}
}
