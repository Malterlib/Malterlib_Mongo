Property.CMakeOutputPath_libmongoc define string = "../.."->MakeAbsolute()
%Target "Lib_mongoc_static"
{
	Compile
	{
		!!Compile.Type "C"
		SearchPath += [
			"../../src/libmongoc/src"->MakeAbsolute(),
			"../../src/libmongoc/src/mongoc"->MakeAbsolute(),
			"../../../../../../External/mongo-c-driver/src/libmongoc/src"->MakeAbsolute(),
			"../../../../../../External/mongo-c-driver/src/common"->MakeAbsolute(),
			"../../../../../../External/mongo-c-driver/src/zlib-1.2.11"->MakeAbsolute(),
			"../../src/zlib-1.2.11"->MakeAbsolute(),
			"../../../../../../External/mongo-c-driver/src/libbson/src"->MakeAbsolute(),
			"../../src/libbson/src"->MakeAbsolute(),
			"../../src/libbson/src/bson"->MakeAbsolute()
		]
		PreprocessorDefines += [
			"BSON_STATIC",
			"MONGOC_COMPILATION",
			"MONGOC_STATIC",
			"_BSD_SOURCE",
			"_CRT_SECURE_NO_WARNINGS",
			"_DEFAULT_SOURCE",
			"_GNU_SOURCE"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Target.Group "External/libmongoc"
	{
		!!Target.Group undefined
	}
	Target.Type "StaticLibrary"
	Target.BaseName "mongoc_static"
