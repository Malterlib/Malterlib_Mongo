%Target "Com_BSONCXX_test_bson"
{
	Compile
	{
		!!Compile.Type "C++"
		SearchPath += [
			`@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src`->MakeAbsolute(),
			`@('../..'->MakeAbsolute())/src`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-cxx-driver`->MakeAbsolute(),
			`@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/third_party/catch/include`->MakeAbsolute()
		]
		PreprocessorDefines += [
			"BSONCXX_STATIC",
			"BSONCXX_TESTING",
			"MONGO_CXX_DRIVER_COMPILING"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Target.Group "External/BSONCXX"
	{
		!!Target.Group undefined
	}
	Target.Type "ConsoleExecutable"
	Target.BaseName "BSONCXX_test_bson"
	Target.BaseFileName "test_bson"
	%Group "src"
	{
		%Group "third_party"
		{
			%Group "catch"
			{
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/third_party/catch/main.cpp`
				{
					Compile.Type "C++"
				}
			}
		}
		%Group "bsoncxx"
		{
			%Group "test"
			{
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/test/bson_b_date.cpp`
				{
					Compile.Type "C++"
				}
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/test/bson_builder.cpp`
				{
					Compile.Type "C++"
				}
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/test/bson_get_values.cpp`
				{
					Compile.Type "C++"
				}
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/test/bson_types.cpp`
				{
					Compile.Type "C++"
				}
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/test/bson_util_itoa.cpp`
				{
					Compile.Type "C++"
				}
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/test/bson_validate.cpp`
				{
					Compile.Type "C++"
				}
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/test/json.cpp`
				{
					Compile.Type "C++"
				}
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/test/view_or_value.cpp`
				{
					Compile.Type "C++"
				}
			}
		}
	}
	%Dependency "Lib_BSONCXX_bsoncxx_testing"
}
