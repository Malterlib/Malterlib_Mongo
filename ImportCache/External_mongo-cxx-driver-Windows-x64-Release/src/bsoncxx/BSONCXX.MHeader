Property.CMakeOutputPath_BSONCXX define string = `@('../..'->MakeAbsolute())`->MakeAbsolute()
%Target "Lib_BSONCXX_bsoncxx"
{
	Compile
	{
		!!Compile.Type "C++"
		SearchPath += [
			`@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src`->MakeAbsolute(),
			`@('../..'->MakeAbsolute())/src`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-cxx-driver`->MakeAbsolute()
		]
		PreprocessorDefines += [
			"BSONCXX_STATIC",
			"MONGO_CXX_DRIVER_COMPILING"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Target.Group "External/BSONCXX"
	{
		!!Target.Group undefined
	}
	Target.Type "StaticLibrary"
	Target.BaseName "BSONCXX_bsoncxx"
	Target.BaseFileName "bsoncxx"
	%Group "src"
	{
		%Group "bsoncxx"
		{
			%Group "array"
			{
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/array/element.cpp`
				{
					Compile.Type "C++"
				}
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/array/value.cpp`
				{
					Compile.Type "C++"
				}
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/array/view.cpp`
				{
					Compile.Type "C++"
				}
			}
			%Group "builder"
			{
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/builder/core.cpp`
				{
					Compile.Type "C++"
				}
			}
			%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/decimal128.cpp`
			{
				Compile.Type "C++"
			}
			%Group "document"
			{
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/document/element.cpp`
				{
					Compile.Type "C++"
				}
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/document/value.cpp`
				{
					Compile.Type "C++"
				}
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/document/view.cpp`
				{
					Compile.Type "C++"
				}
			}
			%Group "exception"
			{
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/exception/error_code.cpp`
				{
					Compile.Type "C++"
				}
			}
			%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/json.cpp`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/oid.cpp`
			{
				Compile.Type "C++"
			}
			%Group "private"
			{
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/private/itoa.cpp`
				{
					Compile.Type "C++"
				}
			}
			%Group "string"
			{
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/string/view_or_value.cpp`
				{
					Compile.Type "C++"
				}
			}
			%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/types.cpp`
			{
				Compile.Type "C++"
			}
			%Group "types"
			{
				%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/types/value.cpp`
				{
					Compile.Type "C++"
				}
			}
			%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/validate.cpp`
			{
				Compile.Type "C++"
			}
		}
	}
}
