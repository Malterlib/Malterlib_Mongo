Property.CMakeOutputPath_MONGOCXX: string = `@('../..'->MakeAbsolute())`->MakeAbsolute()
%Target "Lib_MONGOCXX_mongocxx_static"
{
	Compile
	{
		!!Compile.Type "C++"
		SearchPath += [
			`@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/mongocxx/include/mongocxx/v_noabi`->MakeAbsolute(),
			`@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/mongocxx/include`->MakeAbsolute(),
			`@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/mongocxx/lib/mongocxx/v_noabi`->MakeAbsolute(),
			`@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/mongocxx/lib`->MakeAbsolute(),
			`@('../..'->MakeAbsolute())/src/mongocxx/lib/mongocxx/v_noabi`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-cxx-driver`->MakeAbsolute(),
			`@('../..'->MakeAbsolute())/src/mongocxx/lib`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-cxx-driver`->MakeAbsolute(),
			`@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/include/bsoncxx/v_noabi`->MakeAbsolute(),
			`@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/include`->MakeAbsolute(),
			`@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/lib/bsoncxx/v_noabi`->MakeAbsolute(),
			`@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/lib`->MakeAbsolute(),
			`@('../..'->MakeAbsolute())/src/bsoncxx/lib/bsoncxx/v_noabi`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-cxx-driver`->MakeAbsolute(),
			`@('../..'->MakeAbsolute())/src/bsoncxx/lib`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-cxx-driver`->MakeAbsolute()
		]
		PreprocessorDefines += [
			"BSONCXX_STATIC",
			"MONGOCXX_STATIC",
			"MONGO_CXX_DRIVER_COMPILING"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Target.Group "External/MONGOCXX"
	{
		!!Target.Group undefined
	}
	Target.Type "StaticLibrary"
	Target.BaseName "MONGOCXX_mongocxx_static"
	Target.BaseFileName "mongocxx_static"
	%Group "src"
	{
		%Group "mongocxx"
		{
			%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/mongocxx/lib/mongocxx/v_noabi/mongocxx/bulk_write.cpp`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/mongocxx/lib/mongocxx/v_noabi/mongocxx/change_stream.cpp`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/mongocxx/lib/mongocxx/v_noabi/mongocxx/client.cpp`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/mongocxx/lib/mongocxx/v_noabi/mongocxx/client_encryption.cpp`
			{
