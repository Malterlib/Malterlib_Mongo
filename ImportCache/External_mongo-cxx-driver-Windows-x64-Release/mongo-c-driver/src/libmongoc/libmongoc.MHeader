Property.CMakeOutputPath_libmongoc: string = `@('../../..'->MakeAbsolute())`->MakeAbsolute()
%Target "Lib_libmongoc_utf8proc_obj"
{
	Compile
	{
		!!Compile.Type "C"
		SearchPath += []
		PreprocessorDefines += [
			"HAVE_STDARG_H",
			"UTF8PROC_STATIC",
			"_BSD_SOURCE",
			"_CRT_SECURE_NO_WARNINGS",
			"_DEFAULT_SOURCE",
			"_MLIB_BUILD_CONFIG=Release",
			"_XOPEN_SOURCE=700"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Target.Group "External/libmongoc"
	{
		!!Target.Group undefined
	}
	Target.Type "StaticLibrary"
	Target.BaseName "libmongoc_utf8proc_obj"
	Target.BaseFileName "utf8proc_obj"
	Target.ObjectLibrary true
	%Group "mongo-c-driver"
	{
		%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/utf8proc-2.8.0/utf8proc.c`
		{
			Compile.Type "C"
		}
	}
}
%Target "Lib_libmongoc_mcd_rpc"
{
	Compile
	{
		!!Compile.Type "C"
		SearchPath += [
			`@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/libmongoc/src`->MakeAbsolute(),
			`@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/libbson/src`->MakeAbsolute(),
			`@('../../..'->MakeAbsolute())/mongo-c-driver/src/libbson/src`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-cxx-driver`->MakeAbsolute(),
			`@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/common/src`->MakeAbsolute(),
			`@('../../..'->MakeAbsolute())/mongo-c-driver/src/common/src`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-cxx-driver`->MakeAbsolute()
		]
		PreprocessorDefines += [
			"BSON_STATIC",
			"HAVE_STDARG_H",
			"_BSD_SOURCE",
			"_CRT_SECURE_NO_WARNINGS",
			"_DEFAULT_SOURCE",
			"_MLIB_BUILD_CONFIG=Release",
			"_XOPEN_SOURCE=700"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Target.Group "External/libmongoc"
	{
		!!Target.Group undefined
	}
	Target.Type "StaticLibrary"
	Target.BaseName "libmongoc_mcd_rpc"
	Target.BaseFileName "mcd_rpc"
	%Group "mongo-c-driver"
	{
		%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/libmongoc/src/mongoc/mcd-rpc.c`
		{
			Compile.Type "C"
		}
	}
	%Dependency "Lib_libbson_bson_static"
	{
		Dependency.Indirect true
		Dependency.IndirectOrdered true
	}
}
%Target "Lib_libmongoc_mongoc_static"
{
	Compile
	{
		!!Compile.Type "C"
		SearchPath += [
			`@('../../../../../../..'->MakeAbsolute())/External/zlib`->MakeAbsolute(),
			`@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/utf8proc-2.8.0`->MakeAbsolute(),
			`@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/uthash`->MakeAbsolute(),
