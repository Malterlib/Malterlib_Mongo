			`@('../../..'->MakeAbsolute())/mongo-c-driver/src`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-cxx-driver`->MakeAbsolute(),
			`@('../../..'->MakeAbsolute())/mongo-c-driver/src/common/src`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-cxx-driver`->MakeAbsolute(),
			`@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/libbson/src`->MakeAbsolute(),
			`@('../../..'->MakeAbsolute())/mongo-c-driver/src/libbson/src`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-cxx-driver`->MakeAbsolute()
		]
		PreprocessorDefines += [
			"BSON_STATIC",
			"HAVE_STDARG_H",
			"KMS_MESSAGE_ENABLE_CRYPTO",
			"KMS_MESSAGE_ENABLE_CRYPTO_LIBCRYPTO",
			"KMS_MESSAGE_LITTLE_ENDIAN",
			"KMS_MSG_STATIC",
			"MCOMMON_NAME_PREFIX=_mongoc_mcommon",
			"MONGOC_COMPILATION",
			"MONGOC_STATIC",
			"UTF8PROC_STATIC",
			"_BSD_SOURCE",
			"_CRT_SECURE_NO_WARNINGS",
			"_DEFAULT_SOURCE",
			"_MLIB_BUILD_CONFIG=Release",
			"_XOPEN_SOURCE=700"
		]
	}
