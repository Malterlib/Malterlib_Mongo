Property.CMakeOutputPath_libmongoc: string = `@('../..'->MakeAbsolute())`->MakeAbsolute()
%Target "Lib_libmongoc_mongoc_static"
{
	Compile
	{
		!!Compile.Type "C"
		SearchPath += [
			`@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/kms-message/src`->MakeAbsolute(),
			`@('../..'->MakeAbsolute())/src/libmongoc/src`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-c-driver`->MakeAbsolute(),
			`@('../..'->MakeAbsolute())/src/libmongoc/src/mongoc`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-c-driver`->MakeAbsolute(),
			`@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libmongoc/src`->MakeAbsolute(),
			`@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libmongoc/src/mongoc`->MakeAbsolute(),
			`@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/common`->MakeAbsolute(),
			`@('../..'->MakeAbsolute())/src`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-c-driver`->MakeAbsolute(),
			`@('../..'->MakeAbsolute())/src/common`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-c-driver`->MakeAbsolute(),
			`@('../..'->MakeAbsolute())/src/libbson/src`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-c-driver`->MakeAbsolute(),
			`@('../..'->MakeAbsolute())/src/libbson/src/bson`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-c-driver`->MakeAbsolute(),
			`@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src`->MakeAbsolute(),
			`@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson`->MakeAbsolute()
		]
		PreprocessorDefines += [
			"BSON_STATIC",
			"HAVE_STDARG_H",
			"HAVE_UNISTD_H",
			"KMS_MESSAGE_ENABLE_CRYPTO",
			"KMS_MESSAGE_ENABLE_CRYPTO_LIBCRYPTO",
			"KMS_MSG_STATIC",
			"MCOMMON_NAME_PREFIX=_mongoc_mcommon",
			"MONGOC_COMPILATION",
			"MONGOC_STATIC",
			"_BSD_SOURCE",
			"_DARWIN_C_SOURCE",
			"_DEFAULT_SOURCE",
			"_XOPEN_SOURCE=700"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Target.Group "External/libmongoc"
	{
		!!Target.Group undefined
	}
	Target.Type "StaticLibrary"
	Target.BaseName "libmongoc_mongoc_static"
	Target.BaseFileName "mongoc_static"
	%Group "src"
	{
		%Group "libmongoc"
		{
			%Group "src"
			{
				%Group "mongoc"
				{
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libmongoc/src/mongoc/mongoc-aggregate.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libmongoc/src/mongoc/mongoc-apm.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libmongoc/src/mongoc/mongoc-array.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libmongoc/src/mongoc/mongoc-async.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libmongoc/src/mongoc/mongoc-async-cmd.c`
					{
						Compile.Type "C"
					}
