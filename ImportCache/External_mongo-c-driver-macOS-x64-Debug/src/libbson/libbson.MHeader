Property.CMakeOutputPath_libbson: string = `@('../..'->MakeAbsolute())`->MakeAbsolute()
%Target "Lib_libbson_bson_static"
{
	Compile
	{
		!!Compile.Type "C"
		SearchPath += [
			`@('../..'->MakeAbsolute())/src/libbson/src`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-c-driver`->MakeAbsolute(),
			`@('../..'->MakeAbsolute())/src/libbson/src/bson`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-c-driver`->MakeAbsolute(),
			`@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src`->MakeAbsolute(),
			`@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson`->MakeAbsolute(),
			`@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/common`->MakeAbsolute(),
			`@('../..'->MakeAbsolute())/src`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-c-driver`->MakeAbsolute(),
			`@('../..'->MakeAbsolute())/src/common`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-c-driver`->MakeAbsolute()
		]
		PreprocessorDefines += [
			"BSON_COMPILATION",
			"BSON_STATIC",
			"JSONSL_PARSE_NAN",
			"MCOMMON_NAME_PREFIX=_bson_mcommon",
			"_BSD_SOURCE",
			"_DARWIN_C_SOURCE",
			"_DEFAULT_SOURCE",
			"_XOPEN_SOURCE=700"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Target.Group "External/libbson"
	{
		!!Target.Group undefined
	}
	Target.Type "StaticLibrary"
	Target.BaseName "libbson_bson_static"
	Target.BaseFileName "bson_static"
	%Group "src"
	{
		%Group "libbson"
		{
			%Group "src"
			{
				%Group "bson"
				{
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bcon.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-atomic.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-clock.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-context.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-decimal128.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-error.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-iso8601.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-iter.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-json.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-keys.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-md5.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-memory.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-oid.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-reader.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-string.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-timegm.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-utf8.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-value.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-version-functions.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-writer.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bcon.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-atomic.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-clock.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-cmp.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-compat.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-context.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-decimal128.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-endian.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-error.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-iter.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-json.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-keys.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-macros.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-md5.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-memory.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-oid.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-prelude.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-reader.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-string.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-types.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-utf8.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-value.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-version-functions.h`
					{
						Compile.Disabled true
					}
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/bson-writer.h`
					{
						Compile.Disabled true
					}
					%Group "forwarding"
					{
						%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/bson/forwarding/bson.h`
						{
							Compile.Disabled true
						}
					}
				}
				%Group "jsonsl"
				{
					%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/libbson/src/jsonsl/jsonsl.c`
					{
						Compile.Type "C"
					}
				}
			}
		}
		%Group "common"
		{
			%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/common/common-b64.c`
			{
				Compile.Type "C"
			}
			%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/common/common-md5.c`
			{
				Compile.Type "C"
			}
			%File `@('../../../../../../External/mongo-c-driver'->MakeAbsolute())/src/common/common-thread.c`
			{
				Compile.Type "C"
			}
		}
	}
	%Group "macOS"
	{
		%Group "x64"
		{
			%Group `@(FullConfiguration)`
			{
				%Group "src"
				{
					%Group "libbson"
					{
						%Group "src"
						{
							%Group "bson"
							{
								%File `@('../..'->MakeAbsolute())/src/libbson/src/bson/bson-config.h`
								{
									Compile.Disabled true
								}
								%File `@('../..'->MakeAbsolute())/src/libbson/src/bson/bson-version.h`
								{
									Compile.Disabled true
								}
							}
						}
					}
				}
			}
		}
	}
}
