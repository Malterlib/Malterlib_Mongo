Property.CMakeOutputPath_libbson "@('.'->MakeAbsolute())"
%Target Dll_bson_shared
{
	Compile
	{
		!!Compile.Type C
		SearchPath "@('src/bson'->MakeAbsolute());@('../../../../External/libbson/src/bson'->MakeAbsolute());@('../../../../External/libbson/src'->MakeAbsolute());@(Compile.SearchPath)"
		PreprocessorDefines "BSON_COMPILATION;JSONSL_PARSE_NAN;bson_shared_EXPORTS;@(Compile.PreprocessorDefines)"
	}
	Property.MalterlibTargetNameType Normal
	Target.Group "External/libbson"
	Target.Type SharedDynamicLibrary
	Target.BaseName bson_shared
	%Group src
	{
		%Group bson
		{
			%File "../../../../External/libbson/src/bson/bcon.c"
