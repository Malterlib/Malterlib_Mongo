%Target Exe_test_instance
{
	Compile
	{
		!!Compile.Type C++
		SearchPath "@('../../../../../../External/mongo-cxx-driver/src'->MakeAbsolute());@('../../src'->MakeAbsolute());@('../../../../../../External/mongo-cxx-driver/src/third_party/catch/include'->MakeAbsolute());@(Compile.SearchPath)"
		PreprocessorDefines "BSONCXX_STATIC;MONGOCXX_STATIC;MONGOCXX_TESTING;MONGO_CXX_DRIVER_COMPILING;@(Compile.PreprocessorDefines)"
	}
	Property.MalterlibTargetNameType Normal
	Target.Group "External/MONGOCXX"
	Target.Type ConsoleExecutable
	Target.BaseName test_instance
	%Group src
	{
		%Group third_party
		{
			%Group catch
			{
				%File "../../../../../../External/mongo-cxx-driver/src/third_party/catch/main.cpp"
				{
					Compile.Type C++
				}
			}
		}
		%Group mongocxx
		{
			%Group test
			{
				%File "../../../../../../External/mongo-cxx-driver/src/mongocxx/test/instance.cpp"
				{
					Compile.Type C++
				}
			}
		}
	}
	%Dependency Lib_mongocxx_mocked
	%Dependency Lib_bsoncxx
}
