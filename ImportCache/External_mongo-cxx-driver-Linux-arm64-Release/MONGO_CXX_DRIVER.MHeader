%Target "Tool_MONGO_CXX_DRIVER_uninstall"
{
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Compile.Disabled true
	Target.Group "External/MONGO_CXX_DRIVER"
	{
		!!Target.Group undefined
	}
	Target.Type "Tool"
	Target.BaseName "MONGO_CXX_DRIVER_uninstall"
	Target.BaseFileName "uninstall"
	%Group "Linux"
	{
		%Group "arm64"
		{
			%Group `@(FullConfiguration)`
			{
				%Group "generate_uninstall"
				{
					%Group "CMakeFiles"
					{
						%File `@('.'->MakeAbsolute())/generate_uninstall/CMakeFiles/uninstall.rule`
						{
							Compile
							{
								Custom_CommandLine `sh @(`@('.'->MakeAbsolute())/generate_uninstall/uninstall.sh`->MakeAbsolute()->EscapeHost())`
								AllowNonExisting true
								Disabled false
								Custom_WorkingDirectory `@('.'->MakeAbsolute())/generate_uninstall`->MakeAbsolute()
								Custom_Outputs []
								Custom_Inputs []
							}
						}
					}
				}
			}
		}
	}
}
