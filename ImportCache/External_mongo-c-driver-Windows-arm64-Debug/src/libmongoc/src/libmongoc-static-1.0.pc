prefix=C:/Program Files (x86)/mongo-c-driver
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${exec_prefix}/include

Name: libmongoc
Description: The libmongoc MongoDB client library.
Version: 1.24.3
Requires: libbson-static-1.0
Libs: -L${libdir} -lmongoc-static-1.0  -lkernel32.lib -lcrypt32.lib -lDnsapi -lkernel32.lib
Cflags: -I${includedir}/libmongoc-1.0 -DMONGOC_STATIC
