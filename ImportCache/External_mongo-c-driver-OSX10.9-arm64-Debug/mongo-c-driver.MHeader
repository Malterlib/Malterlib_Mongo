Property.CMakeOutputPath_mongo\-c\-driver define string = `@('.'->MakeAbsolute())`->MakeAbsolute()
%Target "Tool_mongo-c-driver_distcheck"
{
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Compile.Disabled true
	Target.Group "External/mongo-c-driver"
	{
		!!Target.Group undefined
	}
	Target.Type "Tool"
	Target.BaseName "mongo-c-driver_distcheck"
	Target.BaseFileName "distcheck"
	%Group "OSX10.9"
	{
		%Group "arm64"
		{
			%Group `@(FullConfiguration)`
			{
				%Group "CMakeFiles"
				{
					%File `@('.'->MakeAbsolute())/CMakeFiles/distcheck.rule`
					{
						Compile
						{
							Custom_CommandLine `MToolCMake -E echo The\\ dist\\ and\\ distcheck\\ targets\\ are\\ disabled.\\ Set\\ ENABLE_BSON=ON,\\ ENABLE_MAN_PAGES=ON,\\ ENABLE_HTML_DOCS=ON,\\ and\\ generate\\ VERSION_CURRENT\\ to\\ enable.`
							AllowNonExisting true
							Disabled false
							Custom_WorkingDirectory `@('.'->MakeAbsolute())`->MakeAbsolute()
							Custom_Outputs []
							Custom_Inputs []
						}
					}
				}
			}
		}
	}
}
