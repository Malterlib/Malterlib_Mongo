Property.CMakeOutputPath_libbson: string = `@('../../..'->MakeAbsolute())`->MakeAbsolute()
%Target "Lib_libbson_bson_static"
{
	Compile
	{
		!!Compile.Type "C"
		SearchPath += [
			`@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/libbson/src`->MakeAbsolute(),
			`@('../../..'->MakeAbsolute())/mongo-c-driver/src/libbson/src`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-cxx-driver`->MakeAbsolute(),
			`@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/common/src`->MakeAbsolute(),
			`@('../../..'->MakeAbsolute())/mongo-c-driver/src/common/src`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_mongo-cxx-driver`->MakeAbsolute()
		]
		PreprocessorDefines += [
			"BSON_COMPILATION",
			"BSON_STATIC",
			"JSONSL_PARSE_NAN",
			"MCOMMON_NAME_PREFIX=_bson_mcommon",
			"_BSD_SOURCE",
			"_DEFAULT_SOURCE",
			"_MLIB_BUILD_CONFIG=Release",
			"_XOPEN_SOURCE=700"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Target.Group "External/libbson"
	{
		!!Target.Group undefined
	}
	Target.Type "StaticLibrary"
	Target.BaseName "libbson_bson_static"
	Target.BaseFileName "bson_static"
	%Group "mongo-c-driver"
	{
		%Group "src"
		{
			%Group "common"
			{
				%Group "src"
				{
					%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/common/src/common-atomic.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/common/src/common-b64.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/common/src/common-json.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/common/src/common-md5.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/common/src/common-oid.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/common/src/common-string.c`
					{
						Compile.Type "C"
					}
					%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/common/src/common-thread.c`
					{
						Compile.Type "C"
					}
				}
			}
			%Group "libbson"
			{
				%Group "src"
				{
					%Group "bson"
					{
						%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/libbson/src/bson/bson-bcon.c`
						{
							Compile.Type "C"
						}
						%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/libbson/src/bson/bson-bcon.h`
						{
							Compile.Disabled true
						}
						%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/libbson/src/bson/bson-clock.c`
						{
							Compile.Type "C"
						}
						%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/libbson/src/bson/bson-clock.h`
						{
							Compile.Disabled true
						}
						%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/libbson/src/bson/bson-context-private.h`
						{
							Compile.Disabled true
						}
						%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/libbson/src/bson/bson-context.c`
						{
