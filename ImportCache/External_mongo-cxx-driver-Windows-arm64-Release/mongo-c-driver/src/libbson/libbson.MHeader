						%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/libbson/src/bson/bson-timegm-private.h`
						{
							Compile.Disabled true
						}
						%File `@('../../../../../../../External/mongo-cxx-driver'->MakeAbsolute())/mongo-c-driver/src/libbson/src/bson/bson-timegm.c`
						{
