							Custom_CommandLine `python @(`@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/etc/clang_format.py`->MakeAbsolute()->EscapeHost()) lint`
							AllowNonExisting true
							Disabled false
							Custom_WorkingDirectory `@('.'->MakeAbsolute())`->MakeAbsolute()
							Custom_Outputs []
							Custom_Inputs []
						}
					}
				}
			}
		}
	}
}
