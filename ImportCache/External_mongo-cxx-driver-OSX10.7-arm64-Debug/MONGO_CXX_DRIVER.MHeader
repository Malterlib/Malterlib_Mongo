		!!Target.Group undefined
	}
	Target.Type "Tool"
	Target.BaseName "MONGO_CXX_DRIVER_format-lint"
	Target.BaseFileName "format-lint"
	%Group "OSX10.7"
	{
		%Group "arm64"
		{
			%Group `@(FullConfiguration)`
			{
				%Group "CMakeFiles"
