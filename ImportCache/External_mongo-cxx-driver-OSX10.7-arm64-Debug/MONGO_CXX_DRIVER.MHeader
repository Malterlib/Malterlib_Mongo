					Compile.Type "C++"
				}
				%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/document/view.cpp`
				{
					Compile.Type "C++"
				}
			}
			%Group "exception"
			{
				%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/exception/error_code.cpp`
				{
					Compile.Type "C++"
				}
			}
			%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/json.cpp`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mongo-cxx-driver'->MakeAbsolute())/src/bsoncxx/oid.cpp`
			{
				Compile.Type "C++"
			}
