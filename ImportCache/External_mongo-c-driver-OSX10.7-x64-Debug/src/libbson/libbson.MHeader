Property.CMakeOutputPath_libbson "@('../..'->MakeAbsolute())"
%Target Lib_bson_static
{
	Compile
	{
		!!Compile.Type C
		SearchPath "@('../../src/libbson/src/bson'->MakeAbsolute());@('../../../../../../External/mongo-c-driver/src/libbson/src/bson'->MakeAbsolute());@('../../../../../../External/mongo-c-driver/src/libbson/src'->MakeAbsolute());@('../../../../../../External/mongo-c-driver/src/common'->MakeAbsolute());@(Compile.SearchPath)"
		PreprocessorDefines "BSON_COMPILATION;BSON_STATIC;JSONSL_PARSE_NAN;@(Compile.PreprocessorDefines)"
	}
	Property.MalterlibTargetNameType Normal
	Target.Group "External/libbson"
	{
		!!Target.Group ""
	}
	Target.Type StaticLibrary
	Target.BaseName bson_static
