prefix=/usr/local
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${exec_prefix}/include

Name: libbson static archive
Description: The libbson BSON serialization library.
Version: 1.9.3
Libs: -L${libdir} -lbson-static-1.0  -lgcc -lgcc_s -lc -lgcc -lgcc_s /CompiledFiles/Dependencies/Binaries/Malterlib_Linux/SDKs/Linux2.6.sdk/usr/lib/librt.so /CompiledFiles/Dependencies/Binaries/Malterlib_Linux/SDKs/Linux2.6.sdk/usr/lib/libm.so -pthread
Cflags: -I${includedir}/libbson-1.0 -DBSON_STATIC
