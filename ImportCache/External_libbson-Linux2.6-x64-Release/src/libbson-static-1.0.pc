prefix=/usr/local
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${exec_prefix}/include

Name: libbson static archive
Description: The libbson BSON serialization library.
Version: 1.8.1
Libs: -L${libdir} -lbson-static-1.0  -lc /Development/Malterlib/Tools/SDKs/Linux2.6.sdk/usr/lib64/librt.so /Development/Malterlib/Tools/SDKs/Linux2.6.sdk/usr/lib64/libm.so -pthread
Cflags: -I${includedir}/libbson-1.0 -DBSON_STATIC
