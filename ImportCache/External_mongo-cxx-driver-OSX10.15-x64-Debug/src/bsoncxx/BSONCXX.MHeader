%Target Exe_test_bson
{
	Compile
	{
		!!Compile.Type C++
		SearchPath "@('../../../../../../External/mongo-cxx-driver/src'->MakeAbsolute());@('../../src'->MakeAbsolute());@('../../../../../../External/mongo-cxx-driver/src/third_party/catch/include'->MakeAbsolute());@(Compile.SearchPath)"
		PreprocessorDefines "BSONCXX_STATIC;BSONCXX_TESTING;MONGO_CXX_DRIVER_COMPILING;@(Compile.PreprocessorDefines)"
	}
	Property.MalterlibTargetNameType Normal
	Target.Group "External/BSONCXX"
	{
		!!Target.Group ""
	}
	Target.Type ConsoleExecutable
	Target.BaseName test_bson
	%Group src
	{
		%Group third_party
		{
			%Group catch
			{
				%File "../../../../../../External/mongo-cxx-driver/src/third_party/catch/main.cpp"
				{
					Compile.Type C++
				}
			}
		}
		%Group bsoncxx
		{
			%Group test
			{
				%File "../../../../../../External/mongo-cxx-driver/src/bsoncxx/test/bson_b_date.cpp"
				{
					Compile.Type C++
				}
				%File "../../../../../../External/mongo-cxx-driver/src/bsoncxx/test/bson_builder.cpp"
				{
