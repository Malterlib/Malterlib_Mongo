Property
{
	MalterlibMongoBuildBinaries: bool = false // User(Mongo)=true: Support building mongo and mongo-tools binaries
}

%Repository "mongo"
{
	!!MalterlibMongoBuildBinaries true

	Repository
	{
		Type "External"
		Remotes =+ {Name: "upstream", URL: "https://github.com/mongodb/mongo.git"}
	}
}

%Repository "mongo-tools"
{
	!!MalterlibMongoBuildBinaries true

	Repository
	{
		Type "External"
		Remotes =+ {Name: "upstream", URL: "https://github.com/mongodb/mongo-tools.git"}
	}
}
