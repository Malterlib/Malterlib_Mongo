%Target "Malterlib_Mongo_MongoManager"
{
	Property
	{
		MalterlibPostCopyProject "Malterlib_Mongo_MongoManager"
		{
			!!MalterlibPostCopyProject ""
		}
		MalterlibLinkWithOpenSSL true
		MalterlibConcurrency_DistributedActors true
		MalterlibTargetNameType "Normal"
		MongoCxxDriver true

		MalterlibDoExeFS true

		MongoManagerCopySources "@('Source/MongoManager_Restore.sh'->MakeAbsolute())|Source;@(MongoManagerCopySources)"
		MongoManagerCopySources "@('Source/Malterlib_Mongo_App_MongoManager_Mongo*.js'->MakeAbsolute())|Source;@(MongoManagerCopySources)"

		MalterlibExeFSExtraFiles "@(MongoManagerCopySources);@(MalterlibExeFSExtraFiles)"
		MalterlibExeFSPath "@(MongoBinariesPath)/*"
		{
			!MongoBinariesPath ""
		}
	}
	Target
	{
		DebuggerCommandArguments "--daemon-run-debug"
		BaseFileName "MongoManager"
	}
	Compile
	{
		!!CompileDialect "C"
		
		SearchPath "@(Builtin.BasePath)/SDK/curl/include;@(Compile.SearchPath)"
		PreprocessorDefines "CURL_STATICLIB;@(Compile.PreprocessorDefines)"
		PreprocessorDefines "DMibMongo_UseInternalMongo;@(Compile.PreprocessorDefines)"
		{
			!MongoBinariesPath ""
		}
	}
	
	%Group Source
	{
		%File "Source/*"
	}
	%Dependency "Lib_Malterlib_Cloud"
	%Dependency "Lib_Malterlib_Mongo"
	%Dependency "Lib_Malterlib"
}

Property.Malterlib_Mongo_App_Targets "Malterlib_Mongo_MongoManager;@(Malterlib_Mongo_App_Targets)"
