Property
{
	MalterlibMongoSupportUnpatchedMongo "false" // User(Mongo)=true: Set to true to support default unpatched mongo that doesn't use secure TLS settings
	{
		!!MalterlibMongoSupportUnpatchedMongo ""
	}
}

%Target "Malterlib_Mongo_MongoManager"
{
	Property
	{
		MalterlibTestApp true
		MalterlibPostCopyProject "Malterlib_Mongo_MongoManager"
		{
			!!MalterlibPostCopyProject ""
		}
		MalterlibLinkWithOpenSSL true
		MalterlibConcurrency_DistributedActors true
		MalterlibTargetNameType "Normal"
		MongoCxxDriver true

		MalterlibCloudVersionInfo_Backup_AddSyncFlagsWildcards "Dump/DynamicOplog.bson=Append;Dump/oplog.bson=Append;@(MalterlibCloudVersionInfo_Backup_AddSyncFlagsWildcards)"
		
		MalterlibDoExeFS true

		MongoManagerCopySources "@('Source/MongoManager_*.sh'->MakeAbsolute())|Source;@(MongoManagerCopySources)"
		MongoManagerCopySources "@('Source/Malterlib_Mongo_App_MongoManager_Mongo*.js'->MakeAbsolute())|Source;@(MongoManagerCopySources)"

		MalterlibExeFSExtraFiles "@(MongoManagerCopySources);@(MalterlibExeFSExtraFiles)"
		MalterlibExeFSExtraFiles "@(MongoBinariesPath)/bin/*|mongo/bin;@(MalterlibExeFSExtraFiles)"
		{
			!MongoBinariesPath ""
		}
	}
	Target
	{
		DebuggerCommandArguments "--daemon-run-debug"
		BaseFileName "MongoManager"
	}
	Compile
	{
		!!CompileDialect "C"
		
		PreprocessorDefines "DMibMongo_UseInternalMongo;@(Compile.PreprocessorDefines)"
		{
			!MongoBinariesPath ""

		}
		PreprocessorDefines "DMibMongo_SupportUnpatchedMongo;@(Compile.PreprocessorDefines)"
		{
			!!MalterlibMongoSupportUnpatchedMongo true
		}
	}
	
	%Group Source
	{
		%File "Source/*"
	}
	%Dependency "Lib_Malterlib_Cloud"
	%Dependency "Lib_Malterlib_Mongo"
	%Dependency "Lib_Malterlib"
}

Property.Malterlib_Mongo_App_Targets "Malterlib_Mongo_MongoManager;@(Malterlib_Mongo_App_Targets)"
