Property
{
	MalterlibMongoSupportUnpatchedMongo define bool = false // User(Mongo)=true: Set to true to support default unpatched mongo that doesn't use secure TLS settings
	MongoBinariesPath define string?
}

%Target "Malterlib_Mongo_MongoManager"
{
	Property
	{
		ProductName "Malterlib Mongo Manager"
		MalterlibTestApp true
		MalterlibPostCopyProject "Malterlib_Mongo_MongoManager"
		{
			!!MalterlibPostCopyProject undefined
		}
		MalterlibConcurrency_DistributedActors true
		MalterlibTargetNameType "Normal"
		MongoCxxDriver true

		MalterlibCloudVersionInfo_Backup_AddSyncFlagsWildcards =+ [{Pattern: "Dump/DynamicOplog.bson", Flags: ["Append"]}, {Pattern: "Dump/oplog.bson=Append", Flags: ["Append"]}]
		
		MalterlibDoExeFS true

		MongoManagerCopySources define [type(CFileCopyOptions)] = []

		MongoManagerCopySources =+ {Pattern: "Source/MongoManager_*.sh"->MakeAbsolute(), Destination: "Source"}
		MongoManagerCopySources =+ {Pattern: "Source/Malterlib_Mongo_App_MongoManager_Mongo*.js"->MakeAbsolute(), Destination: "Source"}

		MalterlibExeFSExtraFiles =+ MongoManagerCopySources
		MalterlibExeFSExtraFiles =+ {Pattern: `@(MongoBinariesPath)/bin/*`, Destination: "mongo/bin"}
		{
			!MongoBinariesPath undefined
		}
	}
	Target
	{
		DebuggerCommandArguments ["--daemon-run-debug"]
		BaseFileName "MongoManager"
	}
	Compile
	{
		!!CompileDialect "C"
		
		PreprocessorDefines += "DMibMongo_UseInternalMongo"
		{
			!MongoBinariesPath undefined

		}
		PreprocessorDefines += "DMibMongo_SupportUnpatchedMongo"
		{
			!!MalterlibMongoSupportUnpatchedMongo true
		}
	}
	
	%Group "Source"
	{
		%File "Source/*"
	}
	%Dependency "Lib_Malterlib_Cloud"
	%Dependency "Lib_Malterlib_Mongo"
	%Dependency "Lib_Malterlib"
}

Property.Malterlib_Mongo_App_Targets += "Malterlib_Mongo_MongoManager"
