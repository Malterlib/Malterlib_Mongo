Import "../Core/Lib_Malterlib.MTarget"
Import "Apps/*/*.MHeader"

%Repository "mongo-cxx-driver"
{
	Repository
	{
		Type External
		Remotes "upstream=https://github.com/mongodb/mongo-cxx-driver.git;@(Repository.Remotes)"
	}
}

%Repository "mongo-c-driver"
{
	Repository
	{
		Type External
		Remotes "upstream=https://github.com/mongodb/mongo-c-driver.git;@(Repository.Remotes)"
	}
}

%Repository "libbson"
{
	Repository
	{
		Type External
		Remotes "upstream=https://github.com/mongodb/libbson.git;@(Repository.Remotes)"
	}
}

Property
{
	CurlTargetInDependenciesTemplate_TargetName ""
	
	TargetIdentityAbsolutePath "@(Target:this.IdentityAsAbsolutePath->GetPath())"
	
	MalterlibMongoIncludePath_bson "@('../../External/libbson/src/bson'->MakeAbsolute());@(Builtin.Function->GetProperty('Property', 'TargetIdentityAbsolutePath', 'Group:External.Group:libbson.Target:Lib_bson_static.Target:Lib_bson_static'))/src/bson"
	MalterlibMongoIncludePath_mongoc "@('../../External/mongo-c-driver/src/mongoc'->MakeAbsolute());@(Builtin.Function->GetProperty('Property', 'TargetIdentityAbsolutePath', 'Group:External.Group:libmongoc.Target:Lib_mongoc_static.Target:Lib_mongoc_static'))/src/mongoc"

}

%Import "../../External/libbson/CMakeLists.txt"
{
	Import.CMake_FullRebuildVersion 1

	Import.CMake_Variables "ENABLE_STATIC=ON;ENABLE_TESTS=OFF;ENABLE_EXAMPLES=OFF;@(Import.CMake_Variables)"
	Import.CMake_Variables "CMAKE_BUILD_WITH_INSTALL_RPATH=ON;THREADS_PTHREAD_ARG=2;@(Import.CMake_Variables)"
	{
		&
		{
			PlatformFamily Linux
			!HostPlatformFamily Linux 
		}
	}

	Property
	{
		!!PlatformFamily Windows

		MalterlibWindowsNtVersion "_WIN32_WINNT_VISTA"
		MalterlibWindowsVersion "NTDDI_VISTA"
	}

	Compile
	{
		!!MalterlibCompileSupportTabSetings true
		IndentWidth 3
		TabWidth 3
		UsesTabs false
	}
	Compile
	{
 		!!CompileDialect "C"
		
		PrefixHeader ""
	}

	%Target Lib_bson_static
	{
		Property.ImportCacheDir "@(Import.CMake_CacheDirectory)"
		Compile.PreprocessorDefines "BSONCXX_STATIC;MONGOCXX_STATIC;BSON_STATIC;MONGOC_STATIC;@(Compile.PreprocessorDefines)"
		{
	 		!!CompileDialect "C"
		}
	}
}

%Import "../../External/mongo-c-driver/CMakeLists.txt"
{
	Import.CMake_FullRebuildVersion 1

	Import.CMake_Variables "ENABLE_STATIC=ON;MONGOC_ENABLE_STATIC=ON;ENABLE_TESTS=OFF;ENABLE_EXAMPLES=OFF;ENABLE_SASL=OFF;ENABLE_SSL=EXTERNAL_OPENSSL;DISABLE_PACKAGES=ON;ENABLE_AUTOMATIC_INIT_AND_CLEANUP=OFF;@(Import.CMake_Variables)"
	Import.CMake_Variables "CMAKE_BUILD_WITH_INSTALL_RPATH=ON;THREADS_PTHREAD_ARG=2;@(Import.CMake_Variables)"
	{
		&
		{
			PlatformFamily Linux
			!HostPlatformFamily Linux 
		}
	}
	
	Compile
	{
		!!MalterlibCompileSupportTabSetings true
		IndentWidth 3
		TabWidth 3
		UsesTabs false
	}

	Compile
	{
 		!!CompileDialect "C"

		PreprocessorDefines "BSON_STATIC;@(Compile.PreprocessorDefines)"
		PrefixHeader ""
		Warnings "Minimal"
		Warnings_UnusedFunction false
		{
			!!GeneratorFamily Xcode
		}
	}
	
	%Target Lib_mongoc_static
	{
		Compile
		{
	 		!!CompileDialect "C"

			SearchPath "@(MalterlibMongoIncludePath_bson);@(Compile.SearchPath)"
			PreprocessorDefines "BSONCXX_STATIC;MONGOCXX_STATIC;BSON_STATIC;MONGOC_STATIC;@(Compile.PreprocessorDefines)"
		}
	}
}

%Import "../../External/mongo-cxx-driver/CMakeLists.txt"
{
	Import.CMake_FullRebuildVersion 1

	Import.CMake_Variables "CMAKE_CXX_STANDARD=14;BUILD_SHARED_LIBS=OFF;DISABLE_PACKAGES=ON;BSONCXX_POLY_USE_STD=ON;BSONCXX_POLY_USE_MNMLSTC_DEFAULT=OFF;BSONCXX_POLY_USE_BOOST_DEFAULT=OFF;@(Import.CMake_Variables)"
	Import.CMake_Variables "CMAKE_BUILD_WITH_INSTALL_RPATH=ON;THREADS_PTHREAD_ARG=2;@(Import.CMake_Variables)"

	Compile
	{
		!!MalterlibCompileSupportTabSetings true
		IndentWidth 3
		TabWidth 3
		UsesTabs false
	}

	Compile
	{
 		!!CompileDialect "C"

		PrefixHeader ""
		Warnings_DeprecatedDeclarations false
		{
			!!GeneratorFamily Xcode
		}
	}
	Property.IdentityFileName "@(this.Identity->GetFile())"
	
	%Target Lib_bsoncxx
	{
		Compile
		{
	 		!!CompileDialect "C"
	 		
			PreprocessorDefines "BSONCXX_STATIC;MONGOCXX_STATIC;BSON_STATIC;MONGOC_STATIC;@(Compile.PreprocessorDefines)"
			SearchPath "@(MalterlibMongoIncludePath_bson);@(MalterlibMongoIncludePath_mongoc);@(Compile.SearchPath)"
			FullEval true
			ObjectFileName "$(IntDir)/%(Directory)%(FileName).obj"
			{
				&
				{
					PlatformFamily Windows
					|
					{
						IdentityFileName "element.cpp"
						IdentityFileName "value.cpp"
						IdentityFileName "view.cpp"
					}
				}
			}
		}
	}
	%Target Lib_mongocxx
	{
		Compile
		{
	 		!!CompileDialect "C"

			PreprocessorDefines "BSONCXX_STATIC;MONGOCXX_STATIC;BSON_STATIC;MONGOC_STATIC;@(Compile.PreprocessorDefines)"
			SearchPath "@(MalterlibMongoIncludePath_bson);@(MalterlibMongoIncludePath_mongoc);@(Compile.SearchPath)"
			FullEval true
			ObjectFileName "$(IntDir)/%(Directory)%(FileName).obj"
			{
				&
				{
					PlatformFamily Windows
					|
					{
						IdentityFileName "bulk_write.cpp"
						IdentityFileName "client.cpp"
						IdentityFileName "delete.cpp"
						IdentityFileName "pool.cpp"
						IdentityFileName "update.cpp"
						IdentityFileName "pool.cpp"
						IdentityFileName "insert_one.cpp"
						IdentityFileName "replace_one.cpp"
					}
				}
			}
		}
	}
}

Compile
{
	&
	{
		MongoCxxDriver true
		!DocumentationEnabled true
 		CompileDialect "C"
	}
	
	SearchPath "@('../../External/mongo-cxx-driver/src'->MakeAbsolute());@(MalterlibMongoIncludePath_bson);@(Compile.SearchPath)"
	SearchPath "@(Builtin.Function->GetProperty('Property', 'TargetIdentityAbsolutePath', 'Group:External.Group:BSONCXX.Target:Lib_bsoncxx.Target:Lib_bsoncxx'))/src;@(Compile.SearchPath)"
	SearchPath "@(MalterlibMongoIncludePath_mongoc);@(MalterlibMongoIncludePath_bson);@(Compile.SearchPath)"
	PreprocessorDefines "BSONCXX_STATIC;MONGOCXX_STATIC;BSON_STATIC;MONGOC_STATIC;@(Compile.PreprocessorDefines)"
}

Property
{
	&
	{
		MongoCxxDriver true
		TargetIsExecutable true
	}
	MalterlibLinkWithOpenSSL true
}

%Group "{Malterlib}/{Lib_Malterlib_Mongo}"
{
	Property.MongoCxxDriver true

	%Group Mongo
	{
		%Group Include
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Mongo/^*"
		}
		%File "Source/*"
		%Group Documentation
		{
			%File "Documentation/*"
		}
	}
	%Dependency Lib_mongocxx
	{
		!DocumentationEnabled true
		Dependency.Indirect true
	}
	%Dependency Lib_bsoncxx
	{
		!DocumentationEnabled true
		Dependency.Indirect true
	}
	%Dependency Lib_mongoc_static
	{
		!DocumentationEnabled true
		Dependency.Indirect true
	}
	%Dependency Lib_bson_static
	{
		!DocumentationEnabled true
		Dependency.Indirect true
	}
}

Property
{
	MalterlibLibrary_Mongo true
	{
		&
		{
			MalterlibLibrary_Mongo ""
			MalterlibLibrary_All true
		}
	}
	MalterlibSubLibraries "Mongo;@(MalterlibSubLibraries)"
	{
		!!MalterlibLibrary_Mongo true
	}
	MalterlibLibrarySeparate_Lib_Malterlib_Mongo true
	//MalterlibSubLibrarySeparate_Lib_Malterlib_Mongo true
	MalterlibIncludeRoots "@('Include'->MakeAbsolute());@(MalterlibIncludeRoots)"
	{
		!!MalterlibLibrary_Mongo true
	}
}


%Group "{Test}/{Malterlib_Mongo}"
{
	Property
	{
		MalterlibLinkWithOpenSSL true
		MongoCxxDriver true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests "Malterlib_Mongo;@(MalterlibTests)"
	MalterlibTestDependencies_Malterlib_Mongo "Lib_Malterlib_Mongo"
	MalterlibTestFiles_Malterlib_Mongo "@('Test/*'->MakeAbsolute())"
	MalterlibTestExtraGroups_Malterlib_Mongo "{Test}/{Malterlib_Mongo}"
}

%Workspace "Apps_Malterlib_Mongo"
{
	&
	{
		MalterlibEnableInternalWorkspaces true
	}
	
	Property.MalterlibPostCopyProject "Malterlib_Mongo"
	{
		!!TargetIsExecutable true
	}
	
	Property.MalterlibLog_Severities "Error;Critical;Warning;Info"
	{
		!!MalterlibLog_EnableVerboseDebugLog false
	}

	%Target "@(Malterlib_Mongo_App_Targets)"
}
