Import "../Core/Lib_Malterlib.MTarget"
Import "Apps/*/*.MHeader"
Import "Tool/*/*.MHeader"

%Repository "mongo-cxx-driver"
{
	Repository
	{
		Type "External"
		Remotes =+ {Name: "upstream", URL: "https://github.com/mongodb/mongo-cxx-driver.git"}
	}
}

%Repository "mongo-c-driver"
{
	Repository
	{
		Type "External"
		Remotes =+ {Name: "upstream", URL: "https://github.com/mongodb/mongo-c-driver.git"}
	}
}

Property
{
	TargetIdentityAbsolutePath: string = Target:this.IdentityAsAbsolutePath->GetPath()

	MalterlibMongoIncludePath_bson: [string] = [
		"../../External/mongo-c-driver/src/libbson/src"->MakeAbsolute()
		, "../../External/mongo-c-driver/src/libbson/src/bson"->MakeAbsolute()
		, `@(GetProperty(&TargetIdentityAbsolutePath, "Group:External.Group:libbson.Target:Lib_libbson_bson_static.Import:*.Target:Lib_libbson_bson_static"))/src/libbson/src/bson`
	]

	MalterlibMongoIncludePath_mongoc: [string] = [
		"../../External/mongo-c-driver/src/libmongoc/src"->MakeAbsolute()
		, "../../External/mongo-c-driver/src/libmongoc/src/mongoc"->MakeAbsolute()
		, `@(GetProperty(&TargetIdentityAbsolutePath, "Group:External.Group:libmongoc.Target:Lib_libmongoc_mongoc_static.Import:*.Target:Lib_libmongoc_mongoc_static"))/src/libmongoc/src/mongoc`
	]
}

%Import "../../External/mongo-c-driver/CMakeLists.txt"
{
	Import.CMake_FullRebuildVersion `@(Import.CMake_FullRebuildVersion).1`

	Import.CMake_Variables =+ [
		"BUILD_VERSION=1.24.3"
		, "CMAKE_BUILD_WITH_INSTALL_RPATH=ON"
		, "ENABLE_APPLE_FRAMEWORK=OFF"
		, "MONGOC_ENABLE_EXECUTABLES=OFF"
		, "ENABLE_BSON=ON"
		, "ENABLE_STATIC=ON"
		, "MONGOC_ENABLE_STATIC=ON"
		, "ENABLE_TESTS=OFF"
		, "ENABLE_ZSTD=OFF"
		, "ENABLE_EXAMPLES=OFF"
		, "ENABLE_SASL=OFF"
		, "ENABLE_ICU=OFF"
		, "ENABLE_SSL=EXTERNAL_OPENSSL"
		, "DISABLE_PACKAGES=ON"
		, "ENABLE_AUTOMATIC_INIT_AND_CLEANUP=OFF"
		, "ENABLE_SNAPPY=OFF"
		, "ENABLE_SHM_COUNTERS=OFF"
		, "ENABLE_ZLIB=SYSTEM"
		, `ZLIB_INCLUDE_DIR=@("../../External/zlib"->MakeAbsolute())`
		, `ZLIB_LIBRARY=@(Malterlib_DummmyLibrary)`
	]

	Compile
	{
		!!MalterlibCompileSupportTabSetings true
		IndentWidth 3
		TabWidth 3
		UsesTabs false
	}

	Property
	{
		!!PlatformFamily "Windows"

		MalterlibWindowsNtVersion "_WIN32_WINNT_VISTA"
		MalterlibWindowsVersion "NTDDI_VISTA"
	}

	Target.CharacterSet "MultiByte"
	{
		!!PlatformFamily "Windows"
	}

	Compile
	{
		!!CompileDialect "C"

		Analyzer false
		PreprocessorDefines += "BSON_STATIC"
		PrefixHeader undefined
		Warnings "Minimal"
		Warnings_UnusedFunction false
		{
			!!Compiler "Clang"
		}
		Warnings_DeprecatedDeclarations false
		{
			!!Compiler "Clang"
		}
	}

	%Target "Lib_libbson_bson_static"
	{
		Compile.PreprocessorDefines += ["BSONCXX_STATIC", "MONGOCXX_STATIC", "BSON_STATIC", "MONGOC_STATIC"]
		{
			!!CompileDialect "C"
		}
		Compile.PreprocessorDefines += "WIN32_LEAN_AND_MEAN"
		{
			&
			{
				PlatformFamily "Windows"
				CompileDialect "C"
			}
		}
	}

	%Target "Lib_libmongoc_mongoc_static"
	{
		Compile
		{
			!!CompileDialect "C"

			SearchPath += MalterlibMongoIncludePath_bson
			PreprocessorDefines += ["BSONCXX_STATIC", "MONGOCXX_STATIC", "BSON_STATIC", "MONGOC_STATIC"]
			PreprocessorDefines += "WIN32_LEAN_AND_MEAN"
			{
				&
				{
					PlatformFamily "Windows"
					CompileDialect "C"
				}
			}
		}
		%Dependency "Lib_zlib"
		{
			!DocumentationEnabled true
			Dependency.Indirect true
		}
		Target.ExtraGroups =+ "{Malterlib}/{Lib_Malterlib_Cryptography}/{DependOnBoringSSL}"
	}
}

%Import "../../External/mongo-cxx-driver/CMakeLists.txt"
{
	Import.CMake_FullRebuildVersion `@(Import.CMake_FullRebuildVersion).1`

	Import.CMake_Variables =+ [
		"ENABLE_BSON=ON"
		, "CMAKE_CXX_STANDARD=14"
		, "BUILD_SHARED_LIBS=OFF"
		, "DISABLE_PACKAGES=ON"
		, "BSONCXX_POLY_USE_STD=ON"
		, "BSONCXX_POLY_USE_MNMLSTC_DEFAULT=OFF"
		, "BSONCXX_POLY_USE_BOOST_DEFAULT=OFF"
		, "MONGOCXX_LINK_WITH_STATIC_MONGOC=ON"
		, "BSONCXX_LINK_WITH_STATIC_MONGOC=ON"
	]

	Import.CMake_Variables =+ ["CMAKE_BUILD_WITH_INSTALL_RPATH=ON"]
	{
		!!PlatformFamily "Linux"
	}

	Compile
	{
		!!MalterlibCompileSupportTabSetings true
		IndentWidth 3
		TabWidth 3
		UsesTabs false
	}

	Compile
	{
		!!CompileDialect "C"

		Analyzer false
		PrefixHeader undefined
		Warnings_DeprecatedDeclarations false
		{
			!!Compiler "Clang"
		}
		Warnings_AlignMismatch false
		{
			!!Compiler "Clang"
		}
	}
	Property.IdentityFileName: string = this.Identity->GetFile()

	%Target "Lib_BSONCXX_bsoncxx_static"
	{
		Compile
		{
			!!CompileDialect "C"

			PreprocessorDefines += ["BSONCXX_STATIC", "MONGOCXX_STATIC", "BSON_STATIC", "MONGOC_STATIC"]
			PreprocessorDefines += "_SILENCE_CXX17_ITERATOR_BASE_CLASS_DEPRECATION_WARNING"
			{
				!!PlatformFamily "Windows"
			}
			SearchPath += [MalterlibMongoIncludePath_bson..., MalterlibMongoIncludePath_mongoc...]
		}
		Compile
		{
			!!GeneratorFamily "VisualStudio"

			FullEval true
			ObjectFileName "RawMSBuild:$(IntDir)/%(Directory)%(FileName).obj"
			{
				&
				{
					PlatformFamily "Windows"
					|
					{
						IdentityFileName "element.cpp"
						IdentityFileName "value.cpp"
						IdentityFileName "view.cpp"
					}
				}
			}
		}
	}
	%Target "Lib_MONGOCXX_mongocxx_static"
	{
		Compile
		{
			!!CompileDialect "C"

			PreprocessorDefines += ["BSONCXX_STATIC", "MONGOCXX_STATIC", "BSON_STATIC", "MONGOC_STATIC"]
			PreprocessorDefines += "_SILENCE_CXX17_ITERATOR_BASE_CLASS_DEPRECATION_WARNING"
			{
				!!PlatformFamily "Windows"
			}

			SearchPath += [MalterlibMongoIncludePath_bson..., MalterlibMongoIncludePath_mongoc...]
		}
		Compile
		{
			!!GeneratorFamily "VisualStudio"
			FullEval true
			ObjectFileName "RawMSBuild:$(IntDir)/%(Directory)%(FileName).obj"
			{
				&
				{
					PlatformFamily "Windows"
					|
					{
						IdentityFileName "bulk_write.cpp"
						IdentityFileName "client.cpp"
						IdentityFileName "delete.cpp"
						IdentityFileName "pool.cpp"
						IdentityFileName "update.cpp"
						IdentityFileName "pool.cpp"
						IdentityFileName "insert_one.cpp"
						IdentityFileName "replace_one.cpp"
						IdentityFileName "bucket.cpp"
						IdentityFileName "index_view.cpp"
						IdentityFileName "upload.cpp"
						IdentityFileName "change_stream.cpp"
						IdentityFileName "client_session.cpp"
						IdentityFileName "client_encryption.cpp"
						IdentityFileName "rewrap_many_datakey.cpp"
					}
				}
			}
		}
	}
}

%Group "{Malterlib}/{Lib_Malterlib_Mongo}/{TargetInjection}"
{
	!DocumentationEnabled true

	Compile
	{
		&
		{
			!DocumentationEnabled true
			CompileDialect "C"
		}

		SearchPath += ["../../External/mongo-cxx-driver/src"->MakeAbsolute(), MalterlibMongoIncludePath_bson...]
		SearchPath += `@(GetProperty(&TargetIdentityAbsolutePath, "Group:External.Group:BSONCXX.Target:Lib_BSONCXX_bsoncxx_static.Import:*.Target:Lib_BSONCXX_bsoncxx_static"))/src`
		SearchPath += [MalterlibMongoIncludePath_mongoc..., MalterlibMongoIncludePath_bson...]
		PreprocessorDefines += ["BSONCXX_STATIC", "MONGOCXX_STATIC", "BSON_STATIC", "MONGOC_STATIC"]
		PreprocessorDefines += "_SILENCE_CXX17_ITERATOR_BASE_CLASS_DEPRECATION_WARNING"
		{
			!!PlatformFamily "Windows"
		}
	}
}

%Group "{Malterlib}/{Lib_Malterlib_Mongo}"
{
	Property
	{
	}

	Target
	{
		DependencyInjectionGroups =+ "{Malterlib}/{Lib_Malterlib_Mongo}/{TargetInjection}"
		ExtraGroups =+ "{Malterlib}/{Lib_Malterlib_Mongo}/{TargetInjection}"
		ExtraGroups =+ "{Malterlib}/{Lib_Malterlib_Cryptography}/{DependOnBoringSSL}"
	}

	%Group "Mongo"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Mongo/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
	%Dependency "Lib_MONGOCXX_mongocxx_static"
	{
		!DocumentationEnabled true
		Dependency.Indirect true
	}
	%Dependency "Lib_BSONCXX_bsoncxx_static"
	{
		!DocumentationEnabled true
		Dependency.Indirect true
	}
	%Dependency "Lib_libmongoc_mongoc_static"
	{
		!DocumentationEnabled true
		Dependency.Indirect true
	}
	%Dependency "Lib_libbson_bson_static"
	{
		!DocumentationEnabled true
		Dependency.Indirect true
	}
	%Dependency "Lib_Malterlib_Concurrency"
	{
		!DocumentationEnabled true

		Dependency.Indirect true
	}


	%Dependency "resolv"
	{
		&
		{
			!DocumentationEnabled true
			|
			{
				PlatformFamily "macOS"
				PlatformFamily "Linux"
			}
		}

		Dependency
		{
			Type "Library"
			Indirect true
		}
	}
}

Property
{
	MalterlibLibrary_Mongo: bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Mongo"
	{
		!!MalterlibLibrary_Mongo true
	}
	MalterlibLibrarySeparate_Lib_Malterlib_Mongo: bool = true
	//MalterlibSubLibrarySeparate_Lib_Malterlib_Mongo: bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Mongo true
	}
}


%Group "{Test}/{Malterlib_Mongo}"
{
	Property
	{
	}
}

Property
{
	!!MalterlibEnableInternalTests true

	MalterlibTests =+ "Malterlib_Mongo"
	MalterlibTestDependencies_Malterlib_Mongo: [type(CEntity)] = ["Lib_Malterlib_Mongo"]
	MalterlibTestFiles_Malterlib_Mongo: [type(CEntity)] = ["Test/*"->MakeAbsolute()]
	MalterlibTestExtraGroups_Malterlib_Mongo: [string] = ["{Test}/{Malterlib_Mongo}"]
}

Property
{
	Malterlib_Mongo_App_Targets: [type(CEntity)] = []
	Malterlib_All_App_Targets =+ Malterlib_Mongo_App_Targets
}

%Workspace "Apps_Malterlib_Mongo"
{
	&
	{
		MalterlibEnableInternalWorkspaces true
	}

	Property
	{
		MalterlibCloud_EnableVersionUpload true
		{
			!!TargetIsExecutable true
		}
		MalterlibPostCopyProject "Malterlib_Mongo"
		{
			!!TargetIsExecutable true
		}

		MalterlibLog_Severities ["Error", "Critical", "Warning", "Info"]
		{
			!!MalterlibLog_EnableVerboseDebugLog false
		}
	}

	%Target Malterlib_Mongo_App_Targets
}
